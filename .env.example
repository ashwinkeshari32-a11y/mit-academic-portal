# ============================================================================
# MIT ACADEMIC PORTAL — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and populate with your Supabase project credentials.
#
# SECURITY WARNING:
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL in frontend HTML/JS!
# - Only SUPABASE_URL and SUPABASE_ANON_KEY (publishable key) may be sent to
#   the browser client; all data access is protected by PostgreSQL RLS policies.
# ============================================================================

# Public Supabase Project URL (Safe for browser client with RLS enabled)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anon / Publishable Key (Safe for browser client with RLS enabled)
SUPABASE_ANON_KEY=your-public-anon-key-here

# Server-Only Secrets (NEVER expose in frontend / browser)
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key-here
SUPABASE_JWT_SECRET=your-server-only-jwt-secret-here
PORT=3000
